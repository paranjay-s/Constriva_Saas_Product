{
  "$defs": {
    "Column": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "position": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Position",
          "type": "array"
        },
        "width": {
          "default": 0.23,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "default": 0.23,
          "title": "Depth",
          "type": "number"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "title": "Column",
      "type": "object"
    },
    "Level": {
      "properties": {
        "index": {
          "default": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "elevation": {
          "default": 0.0,
          "title": "Elevation",
          "type": "number"
        },
        "wall_height": {
          "default": 3.0,
          "title": "Wall Height",
          "type": "number"
        },
        "wall_height_source": {
          "default": "default",
          "enum": [
            "stated",
            "default"
          ],
          "title": "Wall Height Source",
          "type": "string"
        },
        "walls": {
          "items": {
            "$ref": "#/$defs/Wall"
          },
          "title": "Walls",
          "type": "array"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "title": "Openings",
          "type": "array"
        },
        "rooms": {
          "items": {
            "$ref": "#/$defs/Room"
          },
          "title": "Rooms",
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "title": "Columns",
          "type": "array"
        }
      },
      "title": "Level",
      "type": "object"
    },
    "Opening": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "wall_id": {
          "title": "Wall Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "door",
            "window"
          ],
          "title": "Type",
          "type": "string"
        },
        "offset": {
          "title": "Offset",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        },
        "sill": {
          "default": 0.0,
          "title": "Sill",
          "type": "number"
        },
        "sill_height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sill Height"
        },
        "position": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "inferred": {
          "default": false,
          "title": "Inferred",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "wall_id",
        "type",
        "offset",
        "width",
        "height"
      ],
      "title": "Opening",
      "type": "object"
    },
    "ParserInfo": {
      "description": "Which parser run produced this plan. Lets a stored plan be matched to its PDF.",
      "properties": {
        "pdf_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Sha256"
        },
        "parser_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "ParserInfo",
      "type": "object"
    },
    "Room": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "indoor",
                "semi_open",
                "outdoor",
                "void"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "polygon": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "title": "Polygon",
          "type": "array"
        },
        "height_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height M"
        },
        "is_double_height_void": {
          "default": false,
          "title": "Is Double Height Void",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "polygon"
      ],
      "title": "Room",
      "type": "object"
    },
    "Wall": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Start",
          "type": "array"
        },
        "end": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "End",
          "type": "array"
        },
        "thickness": {
          "default": 0.2,
          "title": "Thickness",
          "type": "number"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "exterior",
                "interior"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "is_exterior": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Exterior"
        },
        "inferred": {
          "default": false,
          "title": "Inferred",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "start",
        "end"
      ],
      "title": "Wall",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "units": {
      "const": "m",
      "default": "m",
      "title": "Units",
      "type": "string"
    },
    "building_type": {
      "default": "other",
      "enum": [
        "villa",
        "apartment",
        "other"
      ],
      "title": "Building Type",
      "type": "string"
    },
    "scale_source": {
      "default": "assumed",
      "enum": [
        "dimension_label",
        "scale_bar",
        "stated_scale",
        "assumed",
        "scale_text",
        "user_reference"
      ],
      "title": "Scale Source",
      "type": "string"
    },
    "project_title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Title"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "client": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client"
    },
    "architect": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Architect"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/Level"
      },
      "title": "Levels",
      "type": "array"
    },
    "confidence": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Confidence",
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "parser": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParserInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "PlanJSON",
  "type": "object"
}
