# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/archplan_test
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=archplan
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
LLM_PROVIDER=
LLM_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Level of the API's own log lines (one line per plan parse is logged at INFO).
# LOG_LEVEL=INFO

# Demo access. Leave off: every request then needs a signed-in user's token.
# When true, a request with no token acts as the one dedicated demo profile below
# (the UUID of a profile created for demos). Never turn it on with real customer data.
AUTH_ALLOW_DEMO_USER=false
AUTH_DEMO_USER_ID=
AUTH_DEMO_USER_EMAIL=

# Frontend
VITE_API_URL=http://localhost:8000          # (older name, not read by the code; kept)
VITE_API_BASE_URL=http://localhost:8000     # the API the frontend calls (frontend/src/lib/api.ts)
VITE_ALLOW_DEMO_USER=false                  # true only with the API's AUTH_ALLOW_DEMO_USER: demo access without signing in
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# 2D floor plan generator (all optional; defaults shown)
# FLOORPLAN_LLM_MODEL=gemini-3.5-flash-lite
# FLOORPLAN_LLM_FALLBACK_MODEL=gemini-3.5-flash
# FLOORPLAN_LLM_TIMEOUT_S=20
# FLOORPLAN_SOLVER_TIME_S=8
# FLOORPLAN_MAX_ATTEMPTS=3
# Keep plans in memory instead of the Supabase plans table:
# FLOORPLAN_STORE=memory

# Material Finder (photo -> materials + quantities). All optional; defaults shown.
# MATERIAL_VISION_MODEL=gemini-3.5-flash-lite
# MATERIAL_VISION_FALLBACK_MODEL=gemini-3.5-flash
# MATERIAL_VISION_THINKING=low
# MATERIAL_TEXT_MODEL=gemini-3.5-flash-lite
# MATERIAL_TEXT_FALLBACK_MODEL=gemini-3.5-flash
# MATERIAL_LLM_TIMEOUT_S=30
# MATERIAL_FALLBACK_TIMEOUT_S=40
# MATERIAL_TEXT_TIMEOUT_S=15
# MATERIAL_MAX_IMAGES=4
# MATERIAL_MAX_IMAGE_MB=10
# MATERIAL_MAX_PLAN_MB=20
# MATERIAL_STORE=memory

# Plan parser (PDF -> PlanJSON). Switching model or vendor is a change of these values only.
# Provider: gemini or anthropic.
PLAN_PARSER_LLM_PROVIDER=gemini
# The model name at that provider (required).
PLAN_PARSER_LLM_MODEL=
# The API key for that provider (required). For gemini only, an empty value falls back to
# LLM_API_KEY and then GEMINI_API_KEY.
PLAN_PARSER_LLM_API_KEY=
# Optional; defaults shown.
# PLAN_PARSER_LLM_TIMEOUT_S=300
# PLAN_PARSER_MAX_PDF_MB=20
# PLAN_PARSER_MAX_PDF_PAGES=10
# Parsed plans are cached by PDF sha256 + parser/prompt/schema version + provider + model:
# PLAN_PARSER_CACHE=on
# PLAN_PARSER_CACHE_DIR=backend/.tmp/plan_cache

# 3D houses: the private PlanTo3D service behind /api/v1/3d (docs/08-3d.md)
PLAN3D_SERVICE_URL=http://127.0.0.1:8080
# Signs the tokens of embedded pages. Set a long random value in production.
PLAN3D_EMBED_SECRET=
# PLAN3D_EMBED_TOKEN_TTL_S=3600
# "memory" keeps job ownership in the API process until the plan3d_jobs table exists
# PLAN3D_STORE=supabase
# PLAN3D_SHARE_TTL_S=2592000               # how long a walkthrough share link works (the owner can turn it off sooner)
# PLAN3D_CREATOR_AGENT=false             # the creator agent: makes library assets for unknown areas (admin)
# PLAN3D_CREATOR_ADMINS=                 # user ids allowed to run the creator agent (empty: nobody)
# PLAN3D_USE_UNREVIEWED=false            # builds may use AI-made assets before an admin approves them
# PLAN3D_AI_GAPFILL=false               # the AI gap-filler: fills what the readers missed (one call per plan)
# PLAN3D_AI_VERIFY=false                # an AI second look at each read plan (one call per plan)
# PLAN3D_ALLOW_FURNITURE_CHANGES=false

# Build emails (optional; with no host the email is only logged)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Floor plan generator: building model, areas and drawing (pro run). Defaults shown;
# values from docs/pro/2d/RULES.md, to be confirmed against the Dubai Building Code.
FLOORPLAN_WALL_EXTERIOR_MM=200
FLOORPLAN_WALL_INTERIOR_MM=150
FLOORPLAN_WALL_PARTITION_MM=100
FLOORPLAN_STOREY_HEIGHT_MM=3300
FLOORPLAN_SETBACK_FRONT_M=3.0
FLOORPLAN_SETBACK_SIDE_M=1.5
FLOORPLAN_SETBACK_REAR_M=1.5
FLOORPLAN_BUILT_UP_SHARE=0.70
FLOORPLAN_BUILT_UP_MIN=0.65
FLOORPLAN_BUILT_UP_MAX=0.75
FLOORPLAN_SITE_RULES=true
FLOORPLAN_FULL_RESOLVE_S=30
FLOORPLAN_SHEET=A3
FLOORPLAN_FURNITURE=true
# Signs the building model embedded in every exported PDF (empty: derived from
# PLAN3D_EMBED_SECRET or SUPABASE_JWT_SECRET; with neither, the model is attached unsigned).
FLOORPLAN_MODEL_SIGNING_KEY=
# Path of the ODA File Converter for DWG export (empty: default install paths; none: no DWG).
FLOORPLAN_DWG_CONVERTER=
