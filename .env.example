# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/archplan_test
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=archplan
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
LLM_PROVIDER=
LLM_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# 2D floor plan generator (all optional; defaults shown)
# FLOORPLAN_LLM_MODEL=gemini-3.5-flash-lite
# FLOORPLAN_LLM_FALLBACK_MODEL=gemini-3.5-flash
# FLOORPLAN_LLM_TIMEOUT_S=20
# FLOORPLAN_SOLVER_TIME_S=8
# FLOORPLAN_MAX_ATTEMPTS=3
# Keep plans in memory instead of the Supabase plans table:
# FLOORPLAN_STORE=memory

# Material Finder (photo -> materials + quantities). All optional; defaults shown.
# MATERIAL_VISION_MODEL=gemini-3.5-flash-lite
# MATERIAL_VISION_FALLBACK_MODEL=gemini-3.5-flash
# MATERIAL_VISION_THINKING=low
# MATERIAL_TEXT_MODEL=gemini-3.5-flash-lite
# MATERIAL_TEXT_FALLBACK_MODEL=gemini-3.5-flash
# MATERIAL_LLM_TIMEOUT_S=30
# MATERIAL_FALLBACK_TIMEOUT_S=40
# MATERIAL_TEXT_TIMEOUT_S=15
# MATERIAL_MAX_IMAGES=4
# MATERIAL_MAX_IMAGE_MB=10
# MATERIAL_MAX_PLAN_MB=20
# MATERIAL_STORE=memory

# Plan parser (PDF -> PlanJSON). All optional; defaults shown.
# The API key is the existing GEMINI_API_KEY / LLM_API_KEY.
# PLAN_PARSER_LLM_PROVIDER=gemini
# PLAN_PARSER_LLM_MODEL=gemini-3.5-flash-lite
# Comma-separated models tried when the main one is down; "none" disables fallback:
# PLAN_PARSER_LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-3.7-flash
# PLAN_PARSER_LLM_TIMEOUT_S=120
# PLAN_PARSER_MAX_PAGES=4
# Parsed plans are cached by PDF sha256 + parser/prompt/schema version:
# PLAN_PARSER_CACHE=on
# PLAN_PARSER_CACHE_DIR=backend/.tmp/plan_cache
