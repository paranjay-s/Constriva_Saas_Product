# never committed: client drawings, reference screenshots, PlanTo3D's jobs and assets
sample_test_pdfs/
docs/reference/
services/planto3d/jobs/
services/planto3d/assets/
services/planto3d/node_modules/


# overnight run: images stay local
docs/overnight/**/*.png
docs/overnight/**/*.jpg
docs/overnight/**/*.jpeg
docs/overnight/**/*.mp4
docs/overnight/style_compare/
docs/overnight/shots/
docs/overnight/testplans/
services/planto3d/areas/
# run3 asset library: generated files stay local; the build scripts and the index schema are committed
services/planto3d/library/*
!services/planto3d/library/build/
!services/planto3d/library/README.md
services/planto3d/library/build/out/
docs/run3/**/*.png
docs/run3/**/*.jpg
docs/run3/**/*.webp
docs/run3/**/*.mp4
docs/run3/**/*.exr
docs/run3/**/*.blend

# merge test screenshots (kept local: docs/merge/REPORT.md lists them)
docs/merge/screens/

# pro run: outside repositories cloned for evaluation only; large raster samples stay local
tools/vendor-eval/
docs/pro/**/*.png
docs/pro/**/*.jpg
docs/pro/**/*.mp4
docs/pro/**/*.exr
docs/pro/**/*.blend
